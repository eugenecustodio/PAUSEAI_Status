---
import type { HealthCheck, HealthStatus } from '../../lib/health';

interface Props {
  check: HealthCheck;
  currentStatus?: HealthStatus;
  stale?: boolean;
}

const { check, currentStatus = check.status, stale = false } = Astro.props;

function statusLabel(status: HealthStatus): string {
  return status === 'not_configured'
    ? 'Not configured'
    : status[0].toUpperCase() + status.slice(1);
}

function evidenceLabel(value: HealthCheck): string {
  if (value.evidenceKind === 'manual') return 'Manual pending';
  return value.evidenceKind[0].toUpperCase() + value.evidenceKind.slice(1);
}

function formatDate(value: string): string {
  return new Intl.DateTimeFormat('en', {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone: 'UTC',
  }).format(new Date(value)) + ' UTC';
}
---

<article class="health-card" data-health-status={currentStatus}>
  <div class="health-card-head">
    <span class="status-pill">{statusLabel(currentStatus)}</span>
    <span class="evidence-label">{evidenceLabel(check)}</span>
  </div>
  <h3>{check.label}</h3>
  <p>
    {stale
      ? `Current state is unknown because this evidence expired. Last recorded result: ${statusLabel(check.status)}.`
      : check.summary}
  </p>
  <div class="health-meta">
    <span>Last check <time datetime={check.checkedAt}>{formatDate(check.checkedAt)}</time></span>
    {check.latencyMs !== undefined && <span>{check.latencyMs} ms</span>}
    {check.errorCode && <span>Code: {check.errorCode}</span>}
  </div>
</article>

<style>
  .health-card {
    display: flex;
    min-height: 230px;
    flex-direction: column;
    padding: clamp(1.25rem, 3vw, 1.6rem);
    border: 1px solid var(--color-line);
    border-radius: 1.35rem;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--status-color) 7%, transparent), transparent 52%),
      var(--color-surface);
  }

  .health-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .health-card h3 {
    max-width: 22ch;
    margin-block: 1.75rem 0.6rem;
    font-size: clamp(1.05rem, 2vw, 1.28rem);
    letter-spacing: -0.025em;
  }

  .health-card > p {
    margin-bottom: 0;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .health-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: auto;
    padding-top: 1.2rem;
    color: var(--color-dim);
    font: 0.65rem/1.5 var(--font-mono);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--status-color);
    font: 0.68rem var(--font-mono);
  }

  .status-pill::before {
    width: 0.45rem;
    height: 0.45rem;
    border: 1px solid currentcolor;
    border-radius: 50%;
    background: currentcolor;
    box-shadow: 0 0 0 4px color-mix(in srgb, currentcolor 12%, transparent);
    content: '';
  }

  .evidence-label {
    margin: 0;
    color: var(--color-focus);
    font: 0.7rem var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  [data-health-status='operational'] { --status-color: var(--color-calm); }
  [data-health-status='degraded'] { --status-color: var(--color-alert); }
  [data-health-status='outage'] { --status-color: #ff8f8f; }
  [data-health-status='unknown'] { --status-color: var(--color-focus); }
  [data-health-status='not_configured'] { --status-color: var(--color-muted); }
</style>
