---
import { SITE_NAME, SITE_SUBTITLE, withBase } from '../lib/site';
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="brand footer-brand" href={withBase('/')} aria-label={`${SITE_NAME} home`}>
        <img src={withBase('/favicon.png')} width="34" height="34" alt="" loading="lazy" />
        <span>{SITE_NAME}</span>
      </a>
      <p>{SITE_SUBTITLE}</p>
    </div>

    <nav aria-label="Footer navigation">
      <a href={withBase('/status/')}>System status</a>
      <a href={withBase('/updates/')}>Updates</a>
      <a href={withBase('/privacy/')}>Privacy</a>
      <a
        href="https://github.com/eugenecustodio/PAUSEAI_Status"
        target="_blank"
        rel="noreferrer"
      >
        View public repository<span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    </nav>

    <p class="footer-note">
      Built as a transparent product record. No analytics, visitor tracking, or browser-side
      access to PAUSE infrastructure.
    </p>
  </div>
</footer>
