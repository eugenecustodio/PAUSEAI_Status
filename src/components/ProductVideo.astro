---
import { withBase } from '../lib/site';
---

<figure class="product-video">
  <div class="video-frame">
    <video
      controls
      playsinline
      preload="none"
      width="540"
      height="960"
      poster={withBase('/media/pause-app-video-poster.png')}
      aria-label="PAUSE AI 45-second product film"
      aria-describedby="product-film-caption"
    >
      <source src={withBase('/media/pause-app-video.mp4')} type="video/mp4" />
      Your browser does not support embedded video. You can
      <a href={withBase('/media/pause-app-video.mp4')}>open the PAUSE AI product film</a> instead.
    </video>
  </div>
  <figcaption id="product-film-caption">
    <span><i aria-hidden="true"></i> Actual app interface</span>
    <span>45 sec · sound available · no autoplay</span>
  </figcaption>
</figure>
