---
import { getCollection } from 'astro:content';
import UpdateFilter from '../../components/UpdateFilter';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/site';

const entries = (await getCollection('updates')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const updates = entries.map((entry) => ({
  title: entry.data.title,
  date: entry.data.date.toISOString(),
  category: entry.data.category,
  status: entry.data.status,
  summary: entry.data.summary,
  authorLabel: entry.data.authorLabel,
  href: withBase(`/updates/${entry.id}/`),
}));
---

<BaseLayout
  title="Updates"
  description="Dated, evidence-linked progress notes from the PAUSE AI build."
>
  <section class="page-hero shell" aria-labelledby="updates-title">
    <p class="eyebrow">Build log · public evidence</p>
    <h1 id="updates-title">Progress, without the theater.</h1>
    <p class="lede">
      Short, dated notes about what shipped, what was verified, and what still needs a human device.
    </p>
  </section>

  <section class="shell updates-section" aria-label="PAUSE AI updates">
    <UpdateFilter updates={updates} client:visible />
    <noscript>
      <div class="updates-grid">
        {updates.map((update) => (
          <article class="update-card">
            <p class="update-category">{update.category} · {update.status}</p>
            <h2><a href={update.href}>{update.title}</a></h2>
            <p>{update.summary}</p>
          </article>
        ))}
      </div>
    </noscript>
  </section>
</BaseLayout>

<style>
  .page-hero { display: flex; min-height: calc(100svh - 76px); flex-direction: column; justify-content: center; padding-block: clamp(5rem, 12vw, 9rem); max-width: 920px; }
  h1 { max-width: 13ch; }
  .updates-section { padding-block: 1rem 8rem; }
</style>
