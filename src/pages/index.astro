---
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import { getCollection } from 'astro:content';
import HeroBoundaryVisual from '../components/HeroBoundaryVisual.astro';
import ProductVideo from '../components/ProductVideo.astro';
import Reveal from '../components/Reveal.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { createFallbackSnapshot, refreshHealthSnapshot, type HealthStatus } from '../lib/health';
import { SITE_SUBTITLE, withBase } from '../lib/site';

const proof = [
  { value: '420', label: 'mobile tests' },
  { value: '53', label: 'backend tests' },
  { value: '9', label: 'Edge Functions' },
  { value: '56', label: 'Expo SDK' },
  { value: '4', label: 'Android versionCode' },
];

const principles = [
  {
    number: '01',
    title: 'Communication stays put',
    copy: 'PAUSE sits above the apps people already use. It is not a messenger, and nobody needs to migrate.',
  },
  {
    number: '02',
    title: 'Boundaries stay human',
    copy: 'You choose the apps, the time, and what may interrupt. Manual release remains visible and reversible.',
  },
  {
    number: '03',
    title: 'AI stays advisory',
    copy: 'Qwen provides structured guidance behind a protected Edge Function. Deterministic policy makes the final call.',
  },
];

const latestUpdates = (await getCollection('updates'))
  .sort((left, right) => right.data.date.valueOf() - left.data.date.valueOf() || left.data.title.localeCompare(right.data.title))
  .slice(0, 3);

const now = new Date();
let health = createFallbackSnapshot(now);
try {
  health = refreshHealthSnapshot(
    JSON.parse(await readFile(resolve('public/status/current.json'), 'utf8')) as unknown,
    now,
  );
} catch {
  // The public fallback already represents this as unknown without leaking build errors.
}

function label(value: string): string {
  return value.replaceAll('_', ' ').replace(/^./, (character) => character.toUpperCase());
}

function statusLabel(value: HealthStatus): string {
  return value === 'not_configured' ? 'Not configured' : label(value);
}
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span>Android-first</span> · Receiver-owned attention</p>
        <h1 id="hero-title">Own the<br /><em>interruption.</em></h1>
        <p class="hero-subtitle">{SITE_SUBTITLE}</p>
        <p class="hero-lede">
          PAUSE adds a calm, private boundary above the apps you already use—holding what can
          wait and making room for what matters now.
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href="#product-film">
            <span class="button-icon" aria-hidden="true">▶</span>
            Watch the 30-second story
          </a>
          <a class="button button--secondary" href={withBase('/status/')}>
            View system status
            <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="hero-footnote">
          No auto-replies. No sender migration. No notification content in PAUSE-owned alerts.
        </p>
      </div>

      <HeroBoundaryVisual />
    </div>
    <div class="hero-rule" aria-hidden="true"><span></span></div>
  </section>

  <section class="proof-band" aria-labelledby="proof-title">
    <div class="shell">
      <div class="proof-heading">
        <p class="eyebrow">Release evidence</p>
        <h2 id="proof-title">Built past the prototype.</h2>
        <p>Verified in the current mobile and backend release gates—not presented as live monitoring.</p>
      </div>
      <dl class="proof-grid">
        {
          proof.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="story-section section-pad" aria-labelledby="story-title">
    <div class="shell">
      <Reveal>
        <div class="story-intro">
          <p class="eyebrow">A different layer</p>
          <h2 id="story-title">Communication stays where it is.<br />Interruption becomes yours.</h2>
          <p>
            Existing apps still carry the conversation. PAUSE gives the receiver a deliberate
            checkpoint between an incoming notification and their attention.
          </p>
        </div>
      </Reveal>

      <div class="principle-grid">
        {
          principles.map((principle, index) => (
            <Reveal delay={index * 90}>
              <article class="principle-card">
                <span class="principle-number" aria-hidden="true">{principle.number}</span>
                <div class="principle-mark" aria-hidden="true"></div>
                <h3>{principle.title}</h3>
                <p>{principle.copy}</p>
              </article>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <section id="product-film" class="film-section section-pad" aria-labelledby="film-title">
    <div class="shell film-grid">
      <Reveal class="film-copy">
        <p class="eyebrow">30-second product film</p>
        <h2 id="film-title">The boundary,<br />in motion.</h2>
        <p>
          See monitoring, boundary modes, the notification vault, calm digests, attention budgets,
          and privacy controls working as one system.
        </p>
        <ul class="signal-list" aria-label="Product film chapters">
          <li><span>01</span> Intentional monitoring</li>
          <li><span>02</span> Deterministic boundaries</li>
          <li><span>03</span> Calm review and digest</li>
          <li><span>04</span> Visible privacy controls</li>
        </ul>
      </Reveal>
      <Reveal delay={120}>
        <ProductVideo />
      </Reveal>
    </div>
  </section>

  <section class="interface-section section-pad" aria-labelledby="interface-title">
    <div class="shell">
      <Reveal>
        <div class="section-heading-row">
          <div>
            <p class="eyebrow">The product</p>
            <h2 id="interface-title">Calm control,<br />not another feed.</h2>
          </div>
          <p>
            Android-first monitoring is opt-in and limited to apps the receiver selects. PAUSE
            keeps the current boundary, held count, and manual controls clear.
          </p>
        </div>
      </Reveal>

      <div class="interface-gallery">
        <Reveal class="interface-shot interface-shot--primary">
          <figure>
            <img
              src={withBase('/images/Step_4_Current_UI.png')}
              width="342"
              height="870"
              loading="lazy"
              alt="PAUSE setup screen explaining that Android notification access is optional and reversible"
            />
            <figcaption><span>01</span> Consent stays reversible</figcaption>
          </figure>
        </Reveal>
        <Reveal class="interface-shot" delay={90}>
          <figure>
            <img
              src={withBase('/images/Welcome_To_Pause_4.png')}
              width="358"
              height="790"
              loading="lazy"
              alt="PAUSE onboarding screen stating that it does not read chat history, auto-reply, or message anyone"
            />
            <figcaption><span>02</span> Not another messenger</figcaption>
          </figure>
        </Reveal>
        <Reveal class="interface-shot" delay={180}>
          <figure>
            <img
              src={withBase('/images/Welcome_To_Pause_5.png')}
              width="359"
              height="800"
              loading="lazy"
              alt="PAUSE onboarding screen explaining that notification access can be revoked at any time"
            />
            <figcaption><span>03</span> Honest permission limits</figcaption>
          </figure>
        </Reveal>
      </div>
    </div>
  </section>

  <section class="pulse-section section-pad" aria-labelledby="pulse-title">
    <div class="shell pulse-grid">
      <Reveal>
        <div class="pulse-copy">
          <p class="eyebrow">Public operating record</p>
          <h2 id="pulse-title">Proof, with the right label.</h2>
          <p>
            Scheduled synthetic checks report backend reachability without touching real users.
            Release tests and physical-device QA remain separate, so “green” keeps an honest meaning.
          </p>
          <a class="text-link" href={withBase('/status/')}>
            Open the full health dashboard <span aria-hidden="true">→</span>
          </a>
        </div>
      </Reveal>

      <Reveal delay={100}>
        <article class="health-preview">
          <div class="health-preview__head">
            <div>
              <span class="health-kicker">System pulse</span>
              <h3>Layered evidence</h3>
            </div>
            <span class="status-badge" data-health-status={health.overallStatus}>
              <span aria-hidden="true"></span>
              {statusLabel(health.overallStatus)}
            </span>
          </div>
          <ul class="health-layers">
            <li>
              <span class="layer-icon layer-icon--focus" aria-hidden="true">L</span>
              <div><strong>Live</strong><small>Auth, database/RLS, Edge availability</small></div>
              <span>30 min</span>
            </li>
            <li>
              <span class="layer-icon layer-icon--calm" aria-hidden="true">D</span>
              <div><strong>Daily</strong><small>Qwen guidance and cleanup lifecycle</small></div>
              <span>24 hrs</span>
            </li>
            <li>
              <span class="layer-icon layer-icon--privacy" aria-hidden="true">R</span>
              <div><strong>Release</strong><small>Tests, EAS build, native release gate</small></div>
              <span>v0.1.0</span>
            </li>
          </ul>
          <p class="health-preview__note">
            Latest sample: <time datetime={health.generatedAt}>{new Intl.DateTimeFormat('en', {
              dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC',
            }).format(new Date(health.generatedAt))} UTC</time>. Runner or network ambiguity is reported as unknown.
          </p>
        </article>
      </Reveal>
    </div>
  </section>

  <section class="updates-preview section-pad" aria-labelledby="updates-title">
    <div class="shell">
      <div class="section-heading-row section-heading-row--compact">
        <Reveal>
          <div>
            <p class="eyebrow">Build journal</p>
            <h2 id="updates-title">Latest from PAUSE.</h2>
          </div>
        </Reveal>
        <a class="text-link" href={withBase('/updates/')}>View all updates <span aria-hidden="true">→</span></a>
      </div>

      <div class="update-card-grid">
        {latestUpdates.map((entry, index) => (
          <Reveal delay={index * 90}>
            <article class="update-preview-card">
              <div class="update-meta">
                <span>{label(entry.data.category)}</span>
                <time datetime={entry.data.date.toISOString()}>
                  {new Intl.DateTimeFormat('en', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(entry.data.date)}
                </time>
              </div>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.summary}</p>
              <a href={withBase(`/updates/${entry.id}/`)} aria-label={`Read ${entry.data.title}`}>
                Read update <span aria-hidden="true">→</span>
              </a>
            </article>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <section class="closing-section" aria-labelledby="closing-title">
    <div class="shell closing-inner">
      <Reveal>
        <p class="eyebrow">PAUSE AI</p>
        <h2 id="closing-title">Your attention is not<br />an open endpoint.</h2>
        <p>See how the system protects that boundary—and how we prove it is working.</p>
        <div class="closing-actions">
          <a class="button button--primary" href="#product-film">Watch the product film</a>
          <a class="button button--secondary" href={withBase('/architecture/')}>Explore the architecture</a>
        </div>
      </Reveal>
    </div>
  </section>
</BaseLayout>
