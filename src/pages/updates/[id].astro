---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('updates');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'updates'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="article-shell shell">
      <a class="back-link" href={withBase('/updates/')}><span aria-hidden="true">←</span> All updates</a>
      <header class="article-header">
        <div class="article-meta">
          <span>{entry.data.category}</span>
          <span>{entry.data.status}</span>
          <time datetime={entry.data.date.toISOString()}>
            {entry.data.date.toLocaleDateString('en', { dateStyle: 'long', timeZone: 'UTC' })}
          </time>
        </div>
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.summary}</p>
        <p class="byline">Published by {entry.data.authorLabel}</p>
      </header>

      <div class="prose">
        <Content />
      </div>

      {entry.data.evidenceLinks?.length ? (
        <aside class="evidence-links" aria-labelledby="evidence-title">
          <p class="eyebrow" id="evidence-title">Evidence</p>
          <ul>
            {entry.data.evidenceLinks.map((link) => (
              <li><a href={link.url} rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a></li>
            ))}
          </ul>
        </aside>
      ) : null}
  </article>
</BaseLayout>

<style>
  .article-shell { max-width: 880px; padding-block: 8rem; }
  .back-link { display: inline-flex; gap: .5rem; margin-bottom: 4rem; color: var(--color-muted); }
  .article-header { padding-bottom: 3rem; border-bottom: 1px solid var(--color-line); }
  .article-meta { display: flex; flex-wrap: wrap; gap: .6rem 1.2rem; color: var(--color-privacy); font: .78rem/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: .08em; }
  .article-header h1 { max-width: 15ch; margin-block: 1.5rem; }
  .byline { color: var(--color-muted); }
  .prose { max-width: 720px; padding-block: 3rem; }
  .prose :global(h2) { margin-top: 2.8rem; }
  .prose :global(p), .prose :global(li) { color: var(--color-soft); font-size: 1.05rem; line-height: 1.8; }
  .prose :global(a) { text-decoration: underline; text-underline-offset: .2em; }
  .evidence-links { margin-top: 2rem; padding: 1.5rem; border: 1px solid var(--color-line); border-radius: var(--radius-lg); background: var(--color-surface); }
  .evidence-links ul { display: grid; gap: .75rem; margin: 1rem 0 0; padding: 0; list-style: none; }
</style>
