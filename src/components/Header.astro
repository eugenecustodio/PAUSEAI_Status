---
import { SITE_NAME, withBase } from '../lib/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const links = [
  { href: '/', label: 'Home', shortLabel: 'Home', accessibleLabel: 'Home' },
  { href: '/status/', label: 'System status', shortLabel: 'Status', accessibleLabel: 'System status' },
  { href: '/updates/', label: 'Updates', shortLabel: 'Updates', accessibleLabel: 'Updates' },
  { href: '/architecture/', label: 'Architecture', shortLabel: 'Flow', accessibleLabel: 'Architecture flow' },
  { href: '/privacy/', label: 'Privacy', shortLabel: 'Privacy', accessibleLabel: 'Privacy' },
];

function isCurrent(href: string): boolean {
  const resolved = withBase(href);
  if (href === '/') return currentPath === resolved || currentPath === `${resolved}/`;
  return currentPath.startsWith(resolved);
}
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={withBase('/')} aria-label={`${SITE_NAME} home`}>
      <img src={withBase('/favicon.png')} width="36" height="36" alt="" />
      <span>{SITE_NAME}</span>
    </a>

    <nav class="primary-nav" aria-label="Primary navigation">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={withBase(link.href)}
                aria-label={link.accessibleLabel}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                <span class="nav-label-long">{link.label}</span>
                <span class="nav-label-short" aria-hidden="true">{link.shortLabel}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
