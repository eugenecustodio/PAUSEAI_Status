---
import { getCollection } from 'astro:content';
import UpdateBrowser from '../../components/UpdateBrowser.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortUpdates } from '../../lib/updates';

const updates = sortUpdates(await getCollection('updates'));
---

<BaseLayout
  title="Updates"
  description="Dated, evidence-linked progress notes from the PAUSE AI build."
>
  <section class="page-hero shell" aria-labelledby="updates-title">
    <p class="eyebrow">Build log · public evidence</p>
    <h1 id="updates-title">Progress, without the theater.</h1>
    <p class="lede">
      Short, dated notes about what shipped, what was verified, and what still needs human review.
    </p>
  </section>

  <section class="shell updates-section" aria-label="PAUSE AI updates">
    <UpdateBrowser updates={updates} />
  </section>
</BaseLayout>

<style>
  .page-hero { padding-block: clamp(5rem, 10vw, 8rem) clamp(3rem, 6vw, 5rem); max-width: 920px; }
  h1 { max-width: 13ch; }
  .updates-section { padding-block: 1rem 8rem; }
</style>
