---
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import { getCollection } from 'astro:content';
import HeroBoundaryVisual from '../components/HeroBoundaryVisual.astro';
import ProductVideo from '../components/ProductVideo.astro';
import Reveal from '../components/Reveal.astro';
import { releaseEvidence } from '../data/release';
import BaseLayout from '../layouts/BaseLayout.astro';
import { createFallbackSnapshot, refreshHealthSnapshot, type HealthStatus } from '../lib/health';
import { SITE_SUBTITLE, withBase } from '../lib/site';

const principles = [
  {
    number: '01',
    label: 'Choose',
    title: 'Set the boundary',
    copy: 'Pick the apps, duration, and exceptions that match this moment. Access remains optional and reversible.',
  },
  {
    number: '02',
    label: 'Broker',
    title: 'Let local rules decide',
    copy: 'Incoming notifications meet your deterministic policy first. AI can advise, but it never gets the final say.',
  },
  {
    number: '03',
    label: 'Review',
    title: 'Return on your terms',
    copy: 'What can wait stays organized for deliberate review, without asking senders or teams to change apps.',
  },
];

const latestUpdates = (await getCollection('updates'))
  .sort(
    (left, right) =>
      right.data.date.valueOf() - left.data.date.valueOf() ||
      left.data.title.localeCompare(right.data.title),
  )
  .slice(0, 2);

const now = new Date();
let health = createFallbackSnapshot(now);
try {
  health = refreshHealthSnapshot(
    JSON.parse(await readFile(resolve('public/status/current.json'), 'utf8')) as unknown,
    now,
  );
} catch {
  // The safe fallback reports unknown rather than carrying an old green state forward.
}

function label(value: string): string {
  return value.replaceAll('_', ' ').replace(/^./, (character) => character.toUpperCase());
}

function statusLabel(value: HealthStatus): string {
  return value === 'not_configured' ? 'Not configured' : label(value);
}

function formatDate(value: Date): string {
  return new Intl.DateTimeFormat('en', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(value);
}

function formatTimestamp(value: string): string {
  return `${new Intl.DateTimeFormat('en', {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone: 'UTC',
  }).format(new Date(value))} UTC`;
}
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span>Android-first</span> · Receiver-owned attention</p>
        <h1 id="hero-title">Own the <em>interruption.</em></h1>
        <p class="hero-subtitle">{SITE_SUBTITLE}</p>
        <p class="hero-lede">
          A calm boundary above the apps you already use. PAUSE helps hold what can wait, lets
          your rules protect the moment, and keeps you in control of when attention returns.
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href="#product-demo">
            <span class="button-icon" aria-hidden="true">▶</span>
            Watch the product demo
          </a>
          <a class="button button--secondary" href={withBase('/status/')}>
            See release evidence
            <span aria-hidden="true">↗</span>
          </a>
        </div>
        <ul class="hero-assurances" aria-label="PAUSE product assurances">
          <li><span aria-hidden="true"></span> Local rules first</li>
          <li><span aria-hidden="true"></span> Reversible access</li>
          <li><span aria-hidden="true"></span> No sender migration</li>
        </ul>
      </div>

      <HeroBoundaryVisual />
    </div>
  </section>

  <section class="proof-band" aria-labelledby="proof-title">
    <div class="shell proof-heading">
      <div>
        <p class="eyebrow">Current release record</p>
        <h2 id="proof-title">Evidence, not adjectives.</h2>
      </div>
      <p>
        Point-in-time release gates are kept separate from live health checks, so every claim
        carries the right clock.
      </p>
    </div>
    <div class="shell proof-grid">
      {
        releaseEvidence.map((item) => (
          <article>
            <p>{item.label}</p>
            <strong>{item.value}</strong>
            <span>{item.detail}</span>
            {item.href && (
              <a href={item.href} target="_blank" rel="noreferrer">
                Inspect build<span class="visually-hidden"> (opens in a new tab)</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="story-section section-pad" aria-labelledby="story-title">
    <div class="shell">
      <Reveal>
        <div class="story-intro">
          <p class="eyebrow">A boundary, not another inbox</p>
          <h2 id="story-title">Communication stays where it is. Attention becomes yours.</h2>
          <p>
            PAUSE does not replace the tools people already trust. It adds a receiver-controlled
            checkpoint between an incoming notification and the moment it asks for.
          </p>
        </div>
      </Reveal>

      <div class="principle-grid">
        {
          principles.map((principle) => (
            <Reveal>
              <article class="principle-card">
                <div class="principle-topline">
                  <span class="principle-number" aria-hidden="true">{principle.number}</span>
                  <span>{principle.label}</span>
                </div>
                <div class="principle-mark" aria-hidden="true"></div>
                <h3>{principle.title}</h3>
                <p>{principle.copy}</p>
              </article>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <section id="product-demo" class="film-section section-pad" aria-labelledby="film-title">
    <div class="shell film-grid">
      <Reveal class="film-copy">
        <p class="eyebrow"><span>Actual app UI</span> · 45 seconds</p>
        <h2 id="film-title">See the boundary in motion.</h2>
        <p>
          Follow a Deep Work boundary from setup to held notification, calm review, digest, and
          visible privacy controls. Playback stays entirely in your hands.
        </p>
        <ol class="signal-list" aria-label="Product film chapters">
          <li><span>00:00</span> Start a receiver-owned boundary</li>
          <li><span>00:12</span> Apply deterministic local rules</li>
          <li><span>00:25</span> Review the Vault and digest</li>
          <li><span>00:37</span> Inspect privacy controls</li>
        </ol>
      </Reveal>
      <Reveal>
        <ProductVideo />
      </Reveal>
    </div>
  </section>

  <section class="interface-section section-pad" aria-labelledby="interface-title">
    <div class="shell">
      <Reveal>
        <div class="section-heading-row">
          <div>
            <p class="eyebrow">Built for deliberate control</p>
            <h2 id="interface-title">Quiet by design. Clear when it matters.</h2>
          </div>
          <p>
            Consent, boundaries, and recovery paths are visible in the interface—not buried in
            settings or softened by vague language.
          </p>
        </div>
      </Reveal>

      <div class="interface-gallery">
        <Reveal class="interface-shot interface-shot--primary">
          <figure>
            <img
              src={withBase('/images/Step_4_Current_UI.png')}
              width="342"
              height="870"
              loading="lazy"
              alt="PAUSE setup screen explaining that Android notification access is optional and reversible"
            />
            <figcaption><span>01</span> Consent stays reversible</figcaption>
          </figure>
        </Reveal>
        <Reveal class="interface-shot">
          <figure>
            <img
              src={withBase('/images/Welcome_To_Pause_4.png')}
              width="358"
              height="790"
              loading="lazy"
              alt="PAUSE onboarding screen explaining that it does not read chat history, auto-reply, or message anyone"
            />
            <figcaption><span>02</span> Not another messenger</figcaption>
          </figure>
        </Reveal>
        <Reveal class="interface-shot">
          <figure>
            <img
              src={withBase('/images/Welcome_To_Pause_5.png')}
              width="359"
              height="800"
              loading="lazy"
              alt="PAUSE onboarding screen explaining that notification access can be revoked at any time"
            />
            <figcaption><span>03</span> Permission limits stay honest</figcaption>
          </figure>
        </Reveal>
      </div>
    </div>
  </section>

  <section class="evidence-section section-pad" aria-labelledby="evidence-title">
    <div class="shell evidence-heading">
      <div>
        <p class="eyebrow">Transparent by default</p>
        <h2 id="evidence-title">A product record you can inspect.</h2>
      </div>
      <p>
        Synthetic health, release gates, architecture decisions, and build notes stay public—
        with unknown and stale states shown instead of assumed away.
      </p>
    </div>

    <div class="shell evidence-grid">
      <article
        class="health-preview"
        data-health-preview
        data-health-status={health.overallStatus}
        aria-labelledby="health-preview-title"
      >
        <div class="health-preview__head">
          <div>
            <span class="health-kicker">Latest scheduled sample</span>
            <h3 id="health-preview-title">System evidence</h3>
          </div>
          <span class="status-badge" data-health-status={health.overallStatus}>
            <span aria-hidden="true"></span>
            {statusLabel(health.overallStatus)}
          </span>
        </div>
        <ul class="health-layers">
          <li>
            <span class="layer-icon layer-icon--focus" aria-hidden="true">L</span>
            <div><strong>Live</strong><small>Auth, database/RLS, Edge availability</small></div>
            <span>30 min</span>
          </li>
          <li>
            <span class="layer-icon layer-icon--calm" aria-hidden="true">D</span>
            <div><strong>Daily</strong><small>AI guidance and cleanup lifecycle</small></div>
            <span>24 hrs</span>
          </li>
          <li>
            <span class="layer-icon layer-icon--privacy" aria-hidden="true">R</span>
            <div><strong>Release</strong><small>Tests, build, and native release gate</small></div>
            <span>point-in-time</span>
          </li>
        </ul>
        <div class="health-preview__foot">
          <p data-health-freshness>
            {health.stale ? 'Frequent evidence is stale; current health is not assumed.' : 'Frequent evidence is within its freshness window.'}
          </p>
          <p>
            Checked <time data-health-generated-at datetime={health.generatedAt}>{formatTimestamp(health.generatedAt)}</time>
          </p>
        </div>
        <a class="text-link" href={withBase('/status/')}>
          Open the full dashboard <span aria-hidden="true">→</span>
        </a>
      </article>

      <div class="journal-preview">
        <div class="journal-preview__head">
          <div>
            <span class="health-kicker">Build journal</span>
            <h3>What changed, and why.</h3>
          </div>
          <a href={withBase('/updates/')} aria-label="View all PAUSE updates">All updates</a>
        </div>
        <div class="journal-list">
          {latestUpdates.map((entry) => (
            <article>
              <div class="update-meta">
                <span>{label(entry.data.category)}</span>
                <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
              </div>
              <h4>{entry.data.title}</h4>
              <p>{entry.data.summary}</p>
              <a href={withBase(`/updates/${entry.id}/`)} aria-label={`Read ${entry.data.title}`}>
                Read entry <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="closing-section" aria-labelledby="closing-title">
    <div class="shell closing-inner">
      <Reveal>
        <img src={withBase('/brand/pause-mark.svg')} width="56" height="56" alt="" loading="lazy" />
        <p class="eyebrow">PAUSE AI</p>
        <h2 id="closing-title">Your attention is not an open endpoint.</h2>
        <p>See the product in motion, then inspect the evidence behind it.</p>
        <div class="closing-actions">
          <a class="button button--primary" href="#product-demo">Watch the product demo</a>
          <a class="button button--secondary" href={withBase('/architecture/')}>Explore the architecture</a>
        </div>
      </Reveal>
    </div>
  </section>
</BaseLayout>
